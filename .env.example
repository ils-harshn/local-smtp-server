# --- Inbound SMTP (receive) ---
SMTP_HOST=0.0.0.0
SMTP_PORT=2525
# Optional: require AUTH before accepting mail (PLAIN). Recommended on any public listener.
SMTP_AUTH_USER=
SMTP_AUTH_PASSWORD=

# Domain name for SMTP EHLO and Message-ID (use your real domain in production).
MAIL_DOMAIN=mail.example.com

# --- Outbound (send) — self-owned default ---
# direct = your server delivers to recipient MX on port 25 (no Gmail/SendGrid).
# relay = optional second SMTP you operate (another host of yours); not a public SaaS requirement.
OUTBOUND_MODE=direct
OUTBOUND_FROM_EMAIL=noreply@example.com

# Only used when OUTBOUND_MODE=relay (your own relay host credentials)
OUTBOUND_SMTP_HOST=
OUTBOUND_SMTP_PORT=587
OUTBOUND_SMTP_USE_TLS=true
OUTBOUND_SMTP_USER=
OUTBOUND_SMTP_PASSWORD=

# --- HTTP API (Render sets PORT automatically) ---
HTTP_HOST=0.0.0.0
PORT=8000

# Optional API key for /send and listing messages (recommended in production)
API_KEY=

# Where received messages are stored
DATA_DIR=data
